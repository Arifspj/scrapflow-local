# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (Neon, Supabase, RDS, etc.).
# In production set this in the Vercel project settings, never in the repo.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Optional ────────────────────────────────────────────────────────────────
# Base URL of the deployment, used for absolute links if needed.
# NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# ── screener.in login (full financial tables) ────────────────────────────────
# Used server-side to fetch the full P&L / balance sheet / cash flow / ratios /
# shareholding tables. Without these the app falls back to the public top ratios.
# NEVER commit real credentials — set them in the Vercel project settings.
# SCREENER_EMAIL="you@example.com"
# SCREENER_PASSWORD="your-password"
